MONGO_URI=mongodb://127.0.0.1:27017/sdn
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=paste-a-long-random-string-here
PORT=5000
NODE_ENV=development
# UPLOAD_DIR=/var/data/uploads   (point at a persistent disk in production)
# Optional: Cloudinary for product photos (recommended on Render). Same names as your old backend:
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_SECRET_KEY=
# For migrate-old.js (read-only): name of the OLD database inside the same Atlas cluster
# LEGACY_DB=e-commerce
