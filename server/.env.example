MONGO_URI=mongodb://127.0.0.1:27017/sdn
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=paste-a-long-random-string-here
PORT=5000
NODE_ENV=development
# Exact public origin of the static frontend (set in Render backend environment)
FRONTEND_ORIGIN=https://your-frontend.onrender.com
# SMTP email delivery (for Gmail, use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-business@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional receiver; the public email saved in /admin is used when blank
CONTACT_TO=
# Optional initial defaults; editable later in /admin
SITE_NAME=Scent Design Nigeria Ltd
SITE_EMAIL=
SITE_PHONE=
SITE_WHATSAPP=
SITE_ADDRESS=7 Oyesina Close, opposite 7 Ibikunle Avenue, Old Bodija, Ibadan, Nigeria
SITE_HOURS=
SITE_MAP_URL=https://maps.google.com/?q=7+oyesina+close+ibadan
SITE_DESCRIPTION=Perfumes made in Ibadan since 1997.
SITE_INSTAGRAM=
SITE_FACEBOOK=
SITE_TIKTOK=
SITE_X=
SITE_YOUTUBE=
# Optional bank account defaults (also editable in /admin)
BANK_ACCOUNT_NAME=Scent Design Nigeria Ltd
BANK_ACCOUNT_NUMBER=0063962854
BANK_NAME=Access Bank
# UPLOAD_DIR=/var/data/uploads   (point at a persistent disk in production)
# Optional: Cloudinary for product photos (recommended on Render). Same names as your old backend:
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_SECRET_KEY=
# For migrate-old.js (read-only): name of the OLD database inside the same Atlas cluster
# LEGACY_DB=e-commerce
